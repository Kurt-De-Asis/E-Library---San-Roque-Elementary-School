{
  "expo": {
    "name": "San Roque E-Library",
    "slug": "elibrary-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sres.elibrary",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.sres.elibrary",
      "usesCleartextTraffic": true
    },
    "web": {},
    "extra": {
      "eas": {
        "projectId": "69c3019b-849d-4251-a2a6-cb786c7f4fd8"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
